{
  "info": {
    "_postman_id": "c7a8b912-34ef-4682-bc10-202512039lab7",
    "name": "Lab 7 - API Gateway & Service Discovery (CampusConnect)",
    "description": "Postman Collection for Lab 7: API Gateway, Configuration-Based Service Discovery & Cloud Deployment.\nAll client requests target the single entry point (API Gateway: port 3000 / Cloud URL), which proxies requests to internal User, Product, and Order services.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Gateway System",
      "item": [
        {
          "name": "GET /health (Gateway Health & Service Registry)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Gateway reports UP with serviceRegistry', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('UP');",
                  "    pm.expect(json.service).to.eql('api-gateway');",
                  "    pm.expect(json.serviceRegistry).to.have.property('/users');",
                  "    pm.expect(json.serviceRegistry).to.have.property('/products');",
                  "    pm.expect(json.serviceRegistry).to.have.property('/orders');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/health",
              "host": ["{{gateway_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "GET / (Gateway Root & Documentation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns gateway info', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.service).to.include('API Gateway');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/",
              "host": ["{{gateway_url}}"],
              "path": [""]
            }
          }
        }
      ]
