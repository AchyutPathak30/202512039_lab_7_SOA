          "name": "GET /users (502 Bad Gateway when Upstream Service is Down)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 502 Bad Gateway or 503 Service Unavailable', function () {",
                  "    pm.expect([502, 503]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Response includes target service details', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.service).to.eql('api-gateway');",
                  "    pm.expect(json.targetService).to.eql('User Service');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
