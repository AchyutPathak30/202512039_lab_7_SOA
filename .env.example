# =================================================================
# CampusConnect Lab 7 - Microservices & API Gateway Environment Config
# =================================================================

# API Gateway Configuration (Single External Entry Point)
GATEWAY_PORT=3000
PORT=3000

# Service Discovery Layer (Target Microservice URLs)
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# Inter-Service and Proxy Timeouts (ms)
REQUEST_TIMEOUT_MS=5000
PROXY_TIMEOUT_MS=5000

# Internal Service Ports
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
